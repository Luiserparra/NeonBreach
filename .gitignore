# VOLTGRID — Unreal Engine 5.8+ (GitHub UnrealEngine.gitignore + extras)
# Place this at the project root (next to Voltgrid.uproject)

# --- IDE / OS ---
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
desktop.ini

# --- Compiled objects / libs / exes (regenerated by UBT) ---
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# --- Generated project files (recreate with right-click Generate VS project) ---
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# --- Source art dumps (optional; keep out of repo) ---
SourceArt/**/*.png
SourceArt/**/*.tga

# --- Engine / UBT build outputs ---
Binaries/
Plugins/**/Binaries/
Intermediate/
Plugins/**/Intermediate/
DerivedDataCache/
Build/

# Whitelist packaging blacklist + icons if you add them later
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# --- Editor / local runtime ---
Saved/
*_BuiltData.uasset

# --- Local / machine-specific config (do NOT ignore Default*.ini under Config/) ---
# Keep Config/Default*.ini and Config/DefaultEngine.ini etc. in git.
# Ignore only local overrides if present:
Config/User*.ini
**/UserGameSettings.ini

# --- Packaging / cook leftovers sometimes left at root ---
FileOpenOrder/
*.log

# --- Rider / ReSharper ---
_ReSharper*/
*.DotSettings.user

# --- Crash / dumps ---
*.dmp
